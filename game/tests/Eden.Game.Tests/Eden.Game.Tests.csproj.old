<Project Sdk="Godot.NET.Sdk/4.7.2">
  <!-- gdUnit4Net scene tests. Needs GODOT_BIN set (scripts/check.sh does it). -->
  <PropertyGroup>
    <RootNamespace>Eden.Game.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NoWarn>NU1605</NoWarn>
    <!-- The folder mirrors the game project via symlinks (see project.godot); compile only our own files. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="gdunit4_testadapter*/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="gdUnit4.api" Version="5.1.0-rc6" />
    <PackageReference Include="gdUnit4.test.adapter" Version="3.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Eden.Game.csproj" />
  </ItemGroup>
</Project>
